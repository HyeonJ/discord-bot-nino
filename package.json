{
  "name": "discord-bot-nino",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "jest --runInBand",
    "lint": "bash scripts/lint-js.sh",
    "test:all": "bash tests/run-all.sh"
  },
  "dependencies": {
    "discord.js": "^14.0.0",
    "dotenv": "^16.0.0",
    "lgtv2": "^1.6.3",
    "playwright": "^1.60.0",
    "puppeteer": "^25.0.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.0.0"
  },
  "jest": {
    "testMatch": [
      "**/tests/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/vault-audit\\.test\\.js$",
      "/tests/vault-audit-llm\\.test\\.js$"
    ]
  }
}
