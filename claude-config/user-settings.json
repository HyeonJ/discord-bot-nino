{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "AskUserQuestion"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/bpx27/.claude/hooks/darren-mention-guard.sh"
          },
          {
            "type": "command",
            "command": "bash /home/bpx27/.claude/hooks/mdweb-link-guard.sh"
          },
          {
            "type": "command",
            "command": "bash /home/bpx27/.claude/hooks/rc-pipe-guard.sh"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/bpx27/yaksu-bot-core-pitfall/hooks/bash-pitfall-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/bpx27/.claude/hooks/claudemd-gist-sync.sh"
          },
          {
            "type": "command",
            "command": "bash /home/bpx27/discord-bot-nino/hooks/cascade-queue.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cc-creator@yaksu-claude-plugins": true,
    "yaksu-history@yaksu-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "yaksu-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "dazebug/yaksu-claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen"
}