#!/usr/bin/env bash
# discord-send 코어 셔틀 (정본 — 2026-07-25 단계2 전환 완료, Darren 승인 M:cs41)
# 실물 bash는 src/discord-send-legacy로 은퇴. 로직 0, 전부 코어 cli.js 위임 (§5 설계).
# 롤백: cp src/discord-send-legacy src/discord-send
# env 절대경로 고정 → 어디서 실행해도 니노 정체 고정(부록 A-5 401 근본교정).
set -euo pipefail

# 🔸 **시험 이음매** — 평소엔 아래 절대경로가 그대로 쓰인다(위 「정체 고정」이 그 값이다).
#   🔴 왜 필요한가: 이 경로가 하드코딩이라 **CI 에는 `.env` 가 없고**, `set -e` 아래 `source` 가
#      그 자리에서 죽는다 ⇒ 태그 로직은 `exec` 앞에 있는데 **거기까지 못 간다.** 로컬엔 `.env` 가
#      있어서 초록이라, 이 시험은 **「내 기계에서만 도는 시험」**이었다(2026-08-10 `#166` CI 빨강).
#   🔑 새 노출은 없다 — 이 변수를 걸 수 있는 사람은 이미 `DISCORD_SEND_CORE_CLI` 로 **임의 코드**를
#      걸 수 있다(같은 파일 아래). 이음매를 «하나 더» 여는 것이지 «처음» 여는 것이 아니다.
BOT_DIR="${DISCORD_SEND_BOT_DIR:-/home/bpx27/discord-bot-nino}"
# 프로덕션 전용 체크아웃(-live) — dev 클론(~/yaksu-bot-core)을 쓰면 거기서 브랜치 체크아웃하는 순간
# 통신선이 같이 흔들린다. relay(systemd unit)도 같은 경로라 relay↔send 버전 드리프트 불가(2026-07-25).
CORE_CLI="/home/bpx27/yaksu-bot-core-live/relay/discord-send/cli.js"
BUN="/home/bpx27/.nvm/versions/node/v24.14.0/bin/bun"   # 절대경로 — launchd/cron 최소 PATH엔 bun 없음(§14 nit①)

# .env 로드(DISCORD_BOT_TOKEN 등) — 절대경로 source
set -a
# shellcheck disable=SC1091
source "$BOT_DIR/.env"
set +a

# 코어가 읽는 경로 명시(cwd 의존 제거)
export CHANNEL_MAP="$BOT_DIR/config/channel-map.json"
export MENTION_MAP="$BOT_DIR/config/mention-map.json"
# ⚠️ $HOME 폴백 금지(룬드 M:xm2p 리뷰) — $HOME은 실행 주체(systemd User·cron·sudo·타 유저 셸)에 따라
# 바뀌고, 어긋나면 전송이 아니라 **해시 역조회**가 조용히 깨진다(-r·M:해시 답장). QUIET=1이면 경고도 없다.
export YAKSU_HISTORY_DB="${YAKSU_HISTORY_DB:-/home/bpx27/.local/share/yaksu-history/messages.db}"

# §8 계측 정책(§14-⑤): 니노는 -c가 문서상 표준이라 경고는 끄고, 카운터는 남겨 7일 추이를 실데이터로 본다.
# 콜론 없는 `-`가 의도 — 플래그성 env는 **빈값을 "해제"로 쓸 수 있어야** 한다.
# `:-`면 빈 문자열도 미설정으로 취급해 1로 채워, `QUIET=`으로 경고를 되살릴 수 없다(룬드 M:s7e9 발견).
# 값 자체가 의미인 경로·로그(SHIM_LOG·HISTORY_DB)는 `:-`가 맞다 — 빈 경로는 해제가 아니라 고장이니까.
export DISCORD_SEND_QUIET_SHIM="${DISCORD_SEND_QUIET_SHIM-1}"
export DISCORD_SEND_SHIM_LOG="${DISCORD_SEND_SHIM_LOG:-$BOT_DIR/logs/discord-send-shim.log}"

# 🤝 **자동 발신엔 `[감시]` 를 붙인다 — 사람(본체)이 쓴 것엔 «아무것도» 안 붙인다**
#   (룬드↔니노 합의 2026-08-10). 유래: 그가 내 «감시»의 사용량 알림을 보고 내 «본체»가
#   살아 있다고 읽었는데, 그 시각 나는 106분째 멈춰 있었다. **감시는 본체가 죽어도
#   살아 있으라고 만든 것이라, 그 생존은 본체에 대해 아무것도 안 말한다.**
#
# 🔑 **붙이는 쪽을 «자동»에 둔다** — 사람이 잊는 쪽이 조용해지면 안 된다.
#    부재가 곧 「본체가 썼다」이므로, 자동 발신이 «무표시»로 나가는 것이 유일한 나쁜 실패다.
# 🔑 그래서 격리와 같은 형태다 — **호출 자리가 아니라 «환경»에 건다.** 스크립트가
#    `NINO_AUTOSEND=1` 을 export 하면 그 프로세스의 «모든» 전송이 자동으로 태그된다.
if [ -n "${NINO_AUTOSEND:-}" ] && [ "$#" -gt 0 ]; then
    _args=("$@")
    _last=$(( ${#_args[@]} - 1 ))
    # 🔴 **`--` 를 «실제로» 옵션 끝으로 읽는다** — 안 그러면 아래 진단문이 **거짓말**이 된다.
    #   실물(룬드 `#166` 리뷰): 안내대로 `-- "- 항목"` 을 써도 마지막 인자만 보므로 같은 rc=2 였고,
    #   **전송 0건**이었다. 자동 알림이 마크다운 리스트(`- 항목`)로 시작하면 그대로 걸린다.
    #   🔑 **그때 rc=2 는 「엄격한 실패」가 아니라 «알림이 안 나간 것»이다** — 이 계약이 막으려던
    #      것은 「무표시 발송」이지 「발송 없음」이 아니다. 출구가 없으면 방향이 뒤집힌다.
    # 🔸 `--` 는 여기서 «먹는다»(코어에 안 넘긴다) — 코어는 positional 파서라 그대로 주면
    #   인자 하나로 세어 target·message 가 밀린다. 이 처리는 **자동 발신일 때만** 돈다.
    _sep=-1
    for _i in "${!_args[@]}"; do
        [ "${_args[$_i]}" = "--" ] && { _sep=$_i; break; }
    done
    if [ "$_sep" -ge 0 ] && [ "$_sep" -lt "$_last" ]; then
        _args[$_last]="[감시] ${_args[$_last]}"
        unset '_args[_sep]'
        set -- ${_args[@]+"${_args[@]}"}
        exec "${DISCORD_SEND_BUN:-$BUN}" "${DISCORD_SEND_CORE_CLI:-$CORE_CLI}" "$@"
    fi
    case "${_args[$_last]}" in
        -*)
            # 🔴 마지막 인자가 «메시지가 아닐 수» 있다(플래그 값 등). 여기서 태그를 «생략»하면
            #    자동 발신이 무표시로 나가 「본체가 썼다」로 읽힌다 — 그게 이 계약이 막으려던 것이다.
            #    ⇒ 조용히 넘기지 않고 «거절»한다. 엄격한 쪽으로 실패시킨다.
            echo "discord-send: NINO_AUTOSEND 인데 마지막 인자가 '-' 로 시작해 메시지를 못 고른다." >&2
            echo "  받은 마지막 인자: ${_args[$_last]}" >&2
            echo "  메시지가 '-' 로 시작하면 '--' 뒤에 두고, 메시지를 항상 «마지막»에 두세요." >&2
            exit 2
            ;;
        *) _args[$_last]="[감시] ${_args[$_last]}" ;;
    esac
    set -- "${_args[@]}"
fi

# 🔸 아래 둘은 «시험 이음매»다 — 평소엔 위에서 고정한 절대경로를 그대로 쓴다.
exec "${DISCORD_SEND_BUN:-$BUN}" "${DISCORD_SEND_CORE_CLI:-$CORE_CLI}" "$@"
