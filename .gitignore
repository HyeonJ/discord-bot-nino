.env
# 시크릿 파일은 **파생형까지** 막아야 한다. `.env` 만 있던 동안 손으로 만든 백업
# (.env.bak-*, .env.bak.2026*, .env.preflip-bak) 7개가 NOT-IGNORED 였고
# `git add -A` 한 번이면 디스코드 토큰이 커밋되는 상태였다 (2026-07-27 실측/차단).
# 검증은 눈으로 읽지 말고: `git check-ignore -q <파일> && echo IGNORED || echo NOT-IGNORED`
.env.*
!.env.example
*.log
__pycache__/
*.pyc
memory/
logs/
node_modules/
package-lock.json
package.json
.worktrees
.worktrees/

# .claude — project settings만 트래킹
.claude/*
!.claude/settings.json

# claude-config — skills/hooks 백업 (홈 디렉토리 ~/.claude/ 미러)
# claude-config/skills/
# claude-config/hooks/
# claude-config/user-settings.json

# OF DRM 디바이스 키 — 절대 커밋 금지 (git add of/ 한 번에 딸려 들어감. 2026-07-25 실수 직전 차단)
of/cdm/
*.wvd

# 런타임/임시 파일
relay-attachments/
null
*.wav
current-playlist.json
cdp-ports.json
playlist-add-results.json
nino-mic-test.txt

# 이미지
nino_avatar.png
.topSection

# 도구 로컬 설정
.python-version
